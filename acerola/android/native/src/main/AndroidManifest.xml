<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The P2PNode (iroh/QUIC) needs this to open sockets. The main app already inherits
         these permissions via the merge of other network dependencies, but this module's
         `androidTest` APK is separate and only inherits :native's own manifest —
         without this here, creating a P2PNode in an instrumented test fails with
         StartupFailed("port unavailable") (socket bind denied, not a port in use). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

</manifest>