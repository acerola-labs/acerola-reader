    <string name="tutorial_title_folder">Organize your folders</string>
    <string name="tutorial_desc_folder">Create a root folder for the library. Inside it, each comic must have its own subfolder with the chapters.</string>
    <string name="tutorial_title_files">Supported formats</string>
    <string name="tutorial_desc_files">Acerola supports .cbz and .cbr files. PDFs are turned into .cbz automatically. Number the chapters inside the comic folder for the best experience.</string>
    <string name="tutorial_formats_title">Supported formats</string>
    <string name="tutorial_formats_subtitle">Acerola reads the following formats:</string>
    <string name="tutorial_formats_cbz_title">Comic Book ZIP</string>
    <string name="tutorial_formats_cbz_badge">Native (SDK)</string>
    <string name="tutorial_formats_cbz_desc">Random-access ZIP container native to the Android SDK. Instant reading with smart in-memory cache and preloading.</string>
    <string name="tutorial_formats_cbz_feat_1">Native to the Android SDK</string>
    <string name="tutorial_formats_cbz_feat_2">In-memory LRU cache</string>
    <string name="tutorial_formats_cbr_title">Comic Book RAR</string>
    <string name="tutorial_formats_cbr_badge">Junrar support</string>
    <string name="tutorial_formats_cbr_desc">Handled by the Junrar library in Java. Each page is extracted on demand straight into memory, with no temporary files.</string>
    <string name="tutorial_formats_cbr_feat_1">On-demand reading</string>
    <string name="tutorial_formats_cbr_feat_2">No leftovers on disk</string>
    <string name="tutorial_formats_pdf_title">PDF document</string>
    <string name="tutorial_formats_pdf_badge">Native PdfRenderer</string>
    <string name="tutorial_formats_pdf_desc">Rendered natively by Android PdfRenderer and turned into CBZ in the background for the best performance.</string>
    <string name="tutorial_formats_pdf_feat_1">Native Android PdfRenderer</string>
    <string name="tutorial_formats_pdf_feat_2">Optimized conversion to CBZ</string>
