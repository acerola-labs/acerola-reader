# relay.acerola.app stays as an alias while released clients still default to it (Android
# AppPreferences, lib/p2p relay_mode.rs); drop it once a release ships relay.reader.acerola.app.
relay.reader.acerola.app, relay.acerola.app {
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

    # Swarm service of the hetzner_acerola-reader-relay stack, over the edge network.
    reverse_proxy hetzner_acerola-reader-relay_relay:80 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
    }

    encode zstd gzip

    log {
        output file /data/relay-access.log
        format json
    }
}
