docs.reader.acerola.app {
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    # Swarm service of the hetzner_docs stack, over the edge network.
    reverse_proxy hetzner_docs_web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
    }

    encode zstd gzip

    log {
        output file /data/docs-access.log
        format json
    }
}
