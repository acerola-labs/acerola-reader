# Acerola standard: LF in every text file, on any OS. Without it, Windows checkouts with
# core.autocrlf=true (the Git for Windows default) turn everything into CRLF on disk and flood
# Prettier and git status with noise. `eol=lf` wins over core.autocrlf for every matching file.
* text=auto eol=lf

# Binaries: never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.jar binary
*.so binary
*.dll binary
*.dylib binary
*.pdf binary
*.cbz binary
*.cbr binary
*.zip binary
*.jks binary
*.keystore binary
